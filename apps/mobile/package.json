{
  "name": "mybills",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:dev": "eas build --profile development",
    "build:prod": "eas build --profile production --platform android",
    "update:dev": "eas update --channel development",
    "update:prod": "eas update --channel production",
    "eas-build-post-install": "pnpm --filter @mybills/dtos --filter @mybills/theme --filter @mybills/utils --filter @mybills/api-client run build"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@mybills/api-client": "workspace:*",
    "@mybills/dtos": "workspace:*",
    "@mybills/theme": "workspace:*",
    "@mybills/utils": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-navigation/bottom-tabs": "^7.9.1",
    "@react-navigation/native": "^7.1.27",
    "@react-navigation/native-stack": "^7.9.1",
    "@tanstack/react-query": "^5.62.0",
    "expo": "~55.0.4",
    "expo-dev-client": "~55.0.36",
    "expo-device": "~55.0.18",
    "expo-localization": "~55.0.13",
    "expo-notifications": "~55.0.24",
    "expo-secure-store": "~55.0.13",
    "expo-status-bar": "~55.0.4",
    "expo-updates": "~55.0.25",
    "i18next": "^25.6.0",
    "react": "19.2.5",
    "react-i18next": "^16.1.6",
    "react-native": "0.83.2",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "~4.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@mybills/typescript-config": "workspace:*",
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
