generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum CategoryTransactionType {
  INCOME
  EXPENSE
}

enum TransactionSeriesType {
  INSTALLMENT
  RECURRING
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String
  refreshToken String?  @map("refresh_token")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  accounts          Account[]
  creditCards       CreditCard[]
  categories        Category[]
  transactions      Transaction[]
  transactionSeries TransactionSeries[]

  @@map("users")
}

model Account {
  id        String   @id @default(uuid())
  name      String
  balance   Int      @default(0) // Valor em centavos
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCards  CreditCard[]
  transactions Transaction[]

  @@map("accounts")
}

model CreditCard {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  accountId  String?  @map("account_id")
  name       String
  limit      Int // Valor em centavos
  closingDay Int      @map("closing_day")
  dueDay     Int      @map("due_day")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account?      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("credit_cards")
}

model Category {
  id        String                    @id @default(uuid())
  userId    String                    @map("user_id")
  name      String
  icon      String                    @default("receipt-outline")
  isSystem  Boolean                   @default(false) @map("is_system")
  types     CategoryTransactionType[]
  createdAt DateTime                  @default(now()) @map("created_at")
  updatedAt DateTime                  @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("categories")
}

model TransactionSeries {
  id                   String                @id @default(uuid())
  userId               String                @map("user_id")
  type                 TransactionSeriesType
  accountId            String?               @map("account_id")
  categoryId           String?               @map("category_id")
  cardId               String?               @map("card_id")
  description          String?
  transactionType      TransactionType       @map("transaction_type")
  amount               Int
  anchorDate           DateTime              @map("anchor_date") @db.Date
  anchorDay            Int                   @map("anchor_day")
  totalOccurrences     Int?                  @map("total_occurrences")
  nextOccurrenceNumber Int                   @default(1) @map("next_occurrence_number")
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, isActive])
  @@map("transaction_series")
}

model Transaction {
  id               String          @id @default(uuid())
  userId           String          @map("user_id")
  accountId        String?         @map("account_id")
  categoryId       String?         @map("category_id")
  cardId           String?         @map("card_id")
  transferGroupId  String?         @map("transfer_group_id")
  seriesId         String?         @map("series_id")
  occurrenceNumber Int?            @map("occurrence_number")
  description      String?
  type             TransactionType
  amount           Int // Valor em centavos
  date             DateTime        @db.Date
  isPaid           Boolean         @default(false) @map("is_paid")
  isProjected      Boolean         @default(false) @map("is_projected")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  card     CreditCard?        @relation(fields: [cardId], references: [id], onDelete: SetNull)
  series   TransactionSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  @@unique([seriesId, occurrenceNumber])
  @@index([transferGroupId])
  @@index([seriesId])
  @@index([userId, date])
  @@map("transactions")
}
